[Unit]
Description=Lich Agent Bridge SessionHub sidecar
After=network.target

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
Environment="PATH=@EXEC_PATH@"
Environment="LAB_CONFIG=@CONFIG_FILE@"
ExecStart="@PROJECT_DIR@/scripts/run-sidecar.sh"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
