{
  "version": 1,
  "controllers": [{
    "name": "quick-seek",
    "script": "bigshot",
    "summary": "Opt-in bounded profile-area search, then one Quick encounter and configured eLoot cleanup. Review character and preset before registration.",
    "characters": ["Testmage"],
    "result_global": "$lab_quick_result",
    "lanes": ["movement", "combat", "inventory"],
    "owner_scripts": ["bigshot", "go2", "eloot"],
    "control_owner_scripts": ["bigshot"],
    "safe_handoff": {"kind": "quick_area"},
    "capability_action": "start",
    "actions": [
      {
        "name": "start", "kind": "launch", "launch_mode": "start",
        "command_template": "bigshot quick seek --area profile --preset {preset}",
        "script_args_template": "quick seek --area profile --preset {preset}",
        "parameters": [{"name": "preset", "type": "enum", "values": ["Reviewed-Encounter"]}],
        "policy": {"category": "combat", "confirmation_required": true}
      },
      {
        "name": "status", "kind": "control",
        "command_template": "bigshot quick status {run_id}", "script_args_template": "",
        "parameters": [{"name": "run_id", "type": "action_id"}],
        "policy": {"category": "inspection", "confirmation_required": false}
      },
      {
        "name": "hold", "kind": "control",
        "command_template": "bigshot quick hold {run_id}", "script_args_template": "",
        "parameters": [{"name": "run_id", "type": "action_id"}],
        "policy": {"category": "combat", "confirmation_required": true}
      },
      {
        "name": "resume", "kind": "control",
        "command_template": "bigshot quick resume {run_id}", "script_args_template": "",
        "parameters": [{"name": "run_id", "type": "action_id"}],
        "policy": {"category": "combat", "confirmation_required": true}
      },
      {
        "name": "retreat", "kind": "control",
        "command_template": "bigshot quick retreat {run_id}", "script_args_template": "",
        "parameters": [{"name": "run_id", "type": "action_id"}],
        "policy": {"category": "combat", "confirmation_required": true}
      }
    ]
  }]
}
